    {
      "name": "odoo_read_group",
      "description": "Aggregate records with GROUP BY, using Odoo's formatted_read_group shape on every version (16-20). groupby entries are fields or 'field:granularity' (day/week/month/quarter/year). aggregates are 'field:agg' (sum, avg, min, max, count, count_distinct, array_agg) or '__count'. Returns groups keyed by each groupby and aggregate spec, e.g. {\"state\": \"draft\", \"amount_total:sum\": 120.0, \"__count\": 3}. 'having' (a domain over aggregates) needs Odoo 19+. fields/lazy/orderby are deprecated and will be removed in 0.8.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance": { "type": "string" },
          "model": { "type": "string" },
          "domain": { "type": "array", "items": {} },
          "groupby": { "type": "array", "items": { "type": "string" } },
          "aggregates": { "type": "array", "items": { "type": "string" } },
          "having": { "type": "array", "items": {} },
          "offset": { "type": "integer" },
          "limit": { "type": "integer" },
          "order": { "type": "string" },
          "context": { "type": "object" },
          "fields": { "type": "array", "items": { "type": "string" }, "description": "Deprecated: use aggregates." },
          "orderby": { "type": "string", "description": "Deprecated: use order." },
          "lazy": { "type": "boolean", "description": "Deprecated: ignored." }
        },
        "required": ["instance", "model", "groupby"],
        "additionalProperties": false
      },
      "op": {
        "type": "read_group",
        "map": {
          "instance": "/instance",
          "model": "/model",
          "domain": "/domain",
          "groupby": "/groupby",
          "aggregates": "/aggregates",
          "having": "/having",
          "offset": "/offset",
          "limit": "/limit",
          "order": "/order",
          "context": "/context",
          "fields": "/fields",
          "orderby": "/orderby",
          "lazy": "/lazy"
        }
      }
    },
