    {
      "name": "odoo_execute_capability",
      "description": "Execute one approval-bound named Odoo mutation capability. Requires an exact registry target, HMAC signature, and durable idempotency state.",
      "pack": "controlled-mutations",
      "guards": { "requiresEnvTrue": "ODOO_CAPABILITY_CONTROLLED_MODE" },
      "inputSchema": {
        "type": "object",
        "properties": {
          "instance": { "type": "string" },
          "capability": { "type": "string", "enum": ["create_crm_lead_draft.v1", "create_quotation_draft.v1", "prepare_vendor_bill_draft.v1", "update_allowed_draft_fields.v1", "import_bank_transaction_draft.v1"] },
          "target": { "type": "object" },
          "actor_ref": { "type": "string" },
          "reviewer_ref": { "type": "string" },
          "approval_ref": { "type": "string" },
          "approval_decided_at": { "type": "string" },
          "approval_expires_at": { "type": "string" },
          "idempotency_key": { "type": "string" },
          "payload_digest": { "type": "string" },
          "correlation_id": { "type": "string" },
          "audit_id": { "type": "string" },
          "registry_revision": { "type": "string" },
          "input": { "type": "object" },
          "signature": { "type": "string" }
        },
        "required": ["instance", "capability", "target", "actor_ref", "reviewer_ref", "approval_ref", "approval_decided_at", "approval_expires_at", "idempotency_key", "payload_digest", "correlation_id", "audit_id", "registry_revision", "input", "signature"],
        "additionalProperties": false
      },
      "op": { "type": "execute_capability", "map": {} }
    },
