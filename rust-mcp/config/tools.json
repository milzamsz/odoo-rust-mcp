        "map": {
          "instance": "/instance",
          "model": "/model",
          "domain": "/domain",
          "fields": "/fields",
          "limit": "/limit",
          "offset": "/offset",
          "order": "/order",
          "context": "/context"
        }
      }
    },
    {
      "name": "odoo_read",
